
{
    "compilerOptions": {
      "target": "ES2020",
      "module": "CommonJS",
      "moduleResolution": "Node",
      "rootDir": ".",
      "outDir": "dist",
      "strict": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true,
      "resolveJsonModule": true,
      "types": ["node", "vitest/globals"]
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"],
    "exclude": ["node_modules", "dist"]
  }
  