  "description": "Subscription & Billing Service fixture and automated validation suite (Kulu SDET assignment)",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
