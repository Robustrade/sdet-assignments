{
  "name": "subscription-billing-validation",
  "version": "1.0.0",
  "private": true,
  "description": "Validation suite (and minimal service fixture) for a Subscription & Billing service",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.js",
    "test": "jest",
    "test:reliability": "jest tests/reliability tests/properties",
    "test:mutation": "node scripts/mutation_check.js",
    "validate-schema": "node scripts/validate_schema.js",
    "verify": "npm run lint && npm run build && npm test && npm run validate-schema"
  },
  "dependencies": {
    "express": "4.22.3",
    "sql.js": "1.12.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "18.19.130",
    "@types/sql.js": "1.4.9",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "fast-check": "3.23.2",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "typescript": "5.6.3"
  }
}
