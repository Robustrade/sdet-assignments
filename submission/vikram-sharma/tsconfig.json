{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",

    "rootDir": "./src",

    "esModuleInterop": true,
    "strict": true,

    "moduleResolution": "node",

    "types": ["node", "jest"],

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true
  },

  "include": [
    "src",
    "tests"
  ]
}