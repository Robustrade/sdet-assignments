    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "jest-html-reporter": "^4.0.0",
    "jest-junit": "^13.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.0"
  }
