<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Suite" verbose="2" parallel="false">

    <listeners>
        <!--
            AllureTestListener: adds suite/class labels to each test in the Allure report.
            Note: allure-testng registers its own AllureTestNg listener via Java SPI automatically —
            DO NOT add AllureTestNg here to avoid double-registration.
        -->
        <listener class-name="com.sdet.billing.listener.AllureTestListener"/>

        <!--
            SlackNotifierListener: fires once per suite with aggregate pass/fail counts.
            Set slack.webhook.url in config.properties (or -Dslack.webhook.url=...) to enable.
            Runs in no-op / log mode when URL is blank.
        -->
        <listener class-name="com.sdet.billing.listener.SlackNotifierListener"/>
    </listeners>

    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="com.sdet.billing.tests"/>
        </packages>
    </test>

</suite>
