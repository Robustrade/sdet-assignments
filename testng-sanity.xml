<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Sanity Suite" verbose="2" parallel="false">

    <listeners>
        <listener class-name="com.sdet.billing.listener.AllureTestListener"/>
        <listener class-name="com.sdet.billing.listener.SlackNotifierListener"/>
    </listeners>

    <test name="Sanity Tests">
        <groups>
            <run>
                <include name="sanity"/>
            </run>
        </groups>
        <packages>
            <package name="com.sdet.billing.tests"/>
        </packages>
    </test>

</suite>
