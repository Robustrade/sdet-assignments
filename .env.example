# Local development only. Tests never read this file - they set their own safe
# defaults inside TestEnvironment so `npm test` works with zero setup.

# HTTP port for `npm run dev` (unused in tests)
PORT=3000

# SQLite file path for `npm run dev` (:memory: is used in tests)
DB_PATH=./data/billing.db

# HMAC-SHA256 secret used to sign webhook payloads (X-Provider-Signature header)
WEBHOOK_SIGNING_SECRET=dev-only-change-me-in-prod
