{
  "name": "robustrade-sdet-assignment",
  "version": "1.0.0",
  "private": true,
  "description": "API and database automation testing for transactional workflows",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:api": "playwright test tests/api",
    "test:db": "playwright test tests/database",
    "test:workflow": "playwright test tests/workflows",
    "test:report": "sh scripts/show-report.sh",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2"
  }
}
