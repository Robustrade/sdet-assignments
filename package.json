{
  "name": "wallet-transfer-automation",
  "version": "1.0.0",
  "description": "Comprehensive Playwright + JavaScript automation framework for Wallet Transfer Service",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test tests/api",
    "test:database": "playwright test tests/database",
    "test:e2e": "playwright test tests/e2e",
    "test:reliability": "playwright test tests/reliability",
    "test:concurrency": "playwright test tests/concurrency",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:allure": "playwright test --reporter=allure-playwright",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "allure:serve": "allure serve ./allure-results",
    "test:report": "npm run test:allure && npm run allure:generate && npm run allure:open",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "setup:db": "node scripts/setup-database.js",
    "validate:schema": "node scripts/validate-schema.js",
    "start:service": "node src/service/app.js",
    "report": "playwright show-report"
  },
  "keywords": [
    "sdet",
    "automation",
    "playwright",
    "wallet-transfer",
    "testing",
    "api-testing",
    "database-testing"
  ],
  "author": "SDET Candidate",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "allure-commandline": "^2.25.0",
    "allure-playwright": "^2.10.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^0.20.0",
    "prettier": "^3.1.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "sql.js": "^1.10.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
